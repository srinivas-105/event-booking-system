# ---- Core ----
ENVIRONMENT=development            # set to "production" on Render (enforces a strong SECRET_KEY)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_booking
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# ---- Organizer sign-up is invite-only: organizers must send this code when registering ----
ORGANIZER_INVITE_CODE=choose-a-secret-invite-code

# ---- Email (real emails via Resend) ----
EMAIL_PROVIDER=resend              # resend | mock  (mock = no real email, only for load tests / unit tests)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# With no verified domain, Resend only allows this sender and only to YOUR OWN account email.
EMAIL_FROM=Event Booking Team <onboarding@resend.dev>
EMAIL_MOCK_LATENCY_MS=0            # only used by the mock provider
RUN_EMAIL_WORKER=true
EMAIL_POLL_SECONDS=2
EMAIL_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=5

# ---- Booking / performance knobs (these are what the load test tunes) ----
BOOKING_MODE=optimized             # baseline | optimized
MAX_TICKETS_PER_BOOKING=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
THREADPOOL_SIZE=40
MAX_CONCURRENT_REQUESTS=0         # 0 = auto (DB_POOL_SIZE + DB_MAX_OVERFLOW - 2)
